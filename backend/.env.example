# Скопируйте в backend/.env
# Полный список переменных — также в корневом `.env.example`.

DATABASE_URL=postgresql+psycopg://antrasha:antrasha@localhost:5433/antrasha
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Суперпользователь админки (не в таблице users — только env). См. корневой `.env.example`.
ADMIN_SUPERUSER_USERNAME=
ADMIN_SUPERUSER_PASSWORD=
ADMIN_SUPERUSER_PASSWORD_BCRYPT=

POSTGRES_APP_USER=antrasha
POSTGRES_APP_PASSWORD=antrasha
POSTGRES_APP_DB=antrasha
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Пусто = только Docker создаёт БД. Задайте логин/пароль суперпользователя для scripts/db-init.sh
POSTGRES_SUPERUSER=
POSTGRES_SUPERUSER_PASSWORD=

SKIP_DOCKER_DB=0
BACKEND_PORT=8000
FRONTEND_PORT=5173
ADMIN_PORT=5174
UVICORN_RELOAD=0

# Yandex Object Storage (см. корневой .env.example)
YC_S3_ENDPOINT=https://storage.yandexcloud.net
YC_S3_REGION=ru-central1
YC_S3_ACCESS_KEY_ID=
YC_S3_SECRET_ACCESS_KEY=
YC_BUCKET_MEN=antrasha-men-foto
YC_BUCKET_WOMEN=antrasha-women-foto
YC_S3_PREFIX_MEN=
YC_S3_PREFIX_WOMEN=

# MAX Bot — уведомления о заявках (см. корневой .env.example)
MAX_BOT_TOKEN=
MAX_NOTIFY_USER_ID=
