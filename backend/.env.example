# Скопируйте в backend/.env
# Полный список переменных — также в корневом `.env.example`.

DATABASE_URL=postgresql+psycopg://antrasha:antrasha@localhost:5433/antrasha
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=43200
JWT_REFRESH_EXPIRE_DAYS=180
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175

# Суперпользователь админки (не в таблице users — только env). См. корневой `.env.example`.
ADMIN_SUPERUSER_USERNAME=
ADMIN_SUPERUSER_PASSWORD=
ADMIN_SUPERUSER_PASSWORD_BCRYPT=

POSTGRES_APP_USER=antrasha
POSTGRES_APP_PASSWORD=antrasha
POSTGRES_APP_DB=antrasha
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Пусто = только Docker создаёт БД. Задайте логин/пароль суперпользователя для scripts/db-init.sh
POSTGRES_SUPERUSER=
POSTGRES_SUPERUSER_PASSWORD=

SKIP_DOCKER_DB=0
BACKEND_PORT=8000
FRONTEND_PORT=5173
ADMIN_PORT=5174
UVICORN_RELOAD=0

# Yandex Object Storage (см. корневой .env.example)
YC_S3_ENDPOINT=https://storage.yandexcloud.net
YC_S3_REGION=ru-central1
YC_S3_ACCESS_KEY_ID=
YC_S3_SECRET_ACCESS_KEY=
YC_BUCKET_MEN=antrasha-men-foto
YC_BUCKET_WOMEN=antrasha-women-foto
YC_S3_PREFIX_MEN=
YC_S3_PREFIX_WOMEN=

# MAX Bot — уведомления о заявках (см. корневой .env.example)
MAX_BOT_TOKEN=
MAX_NOTIFY_USER_ID=

# Web Push (PWA) — см. корневой .env.example и scripts/generate_vapid_keys.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_SUB=mailto:notify@antrasha.ru
PUBLIC_APP_URL=http://localhost:5173

# Anthropic + MCP МойСклад (админка → AI ассистент ANTRASHA, только superuser). См. корневой .env.example
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
MOYSKLAD_MCP_URL=
MOYSKLAD_MCP_AUTH_TOKEN=
MOYSKLAD_MCP_SERVER_NAME=moysklad
# MOYSKLAD_MCP_ALLOWED_TOOLS=
# MOYSKLAD_MCP_DENIED_TOOLS=
# REST API токен МойСклад (аутлет: штрихкод + загрузка изображений). См. корневой .env.example
MOYSKLAD_TOKEN=
