# Внутрисетевое подключение к postgres-контейнеру
DATABASE_URL=postgresql+psycopg://antrasha:change-me-strong-password@postgres:5432/antrasha
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_APP_USER=antrasha
POSTGRES_APP_PASSWORD=change-me-strong-password
POSTGRES_APP_DB=antrasha

# Безопасность
JWT_SECRET=change-me-long-random-string
JWT_EXPIRE_MINUTES=10080

# CORS для прод-доменов
CORS_ORIGINS=https://app.example.ru,https://admin.example.ru

# Суперпользователь админки (заполнить обязательно для /auth/admin/superuser)
ADMIN_SUPERUSER_USERNAME=admin
# В проде лучше использовать bcrypt, а не plain пароль.
ADMIN_SUPERUSER_PASSWORD=
ADMIN_SUPERUSER_PASSWORD_BCRYPT=

# Логи
LOG_LEVEL=INFO

# Внутренний sync endpoint (опционально)
INTERNAL_SYNC_SECRET=
YC_AUTO_SYNC_INTERVAL_MINUTES=0

# Yandex Object Storage (опционально)
YC_S3_ENDPOINT=https://storage.yandexcloud.net
YC_S3_REGION=ru-central1
YC_S3_ACCESS_KEY_ID=
YC_S3_SECRET_ACCESS_KEY=
YC_BUCKET_MEN=antrasha-men-foto
YC_BUCKET_WOMEN=antrasha-women-foto
YC_S3_PREFIX_MEN=
YC_S3_PREFIX_WOMEN=

# Fashn / Ximilar (опционально)
FASHN_API_KEY=
FASHN_HTTPS_PROXY=
API_XIMILAR=
