# Внутрисетевое подключение к postgres-контейнеру
DATABASE_URL=postgresql+psycopg://antrasha:change-me-strong-password@postgres:5432/antrasha
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_APP_USER=antrasha
POSTGRES_APP_PASSWORD=change-me-strong-password
POSTGRES_APP_DB=antrasha

# Безопасность
JWT_SECRET=change-me-long-random-string
# Access JWT ~30 дней; refresh — JWT_REFRESH_EXPIRE_DAYS (по умолчанию 180).
JWT_EXPIRE_MINUTES=43200
JWT_REFRESH_EXPIRE_DAYS=180

# CORS для прод-доменов
CORS_ORIGINS=https://antrasha.ru,https://www.antrasha.ru,https://new.antrasha.ru,https://admin.antrasha.ru,https://work.antrasha.ru

# Суперпользователь админки (заполнить обязательно для /auth/admin/superuser)
ADMIN_SUPERUSER_USERNAME=admin
# В проде лучше использовать bcrypt, а не plain пароль.
ADMIN_SUPERUSER_PASSWORD=
ADMIN_SUPERUSER_PASSWORD_BCRYPT=

# Логи
LOG_LEVEL=INFO

# Внутренний sync endpoint (опционально)
INTERNAL_SYNC_SECRET=
YC_AUTO_SYNC_INTERVAL_MINUTES=0

# Yandex Object Storage (опционально)
YC_S3_ENDPOINT=https://storage.yandexcloud.net
YC_S3_REGION=ru-central1
YC_S3_ACCESS_KEY_ID=
YC_S3_SECRET_ACCESS_KEY=
YC_BUCKET_MEN=antrasha-men-foto
YC_BUCKET_WOMEN=antrasha-women-foto
YC_S3_PREFIX_MEN=
YC_S3_PREFIX_WOMEN=

# MAX Bot — уведомления о новых заявках на примерку (опционально)
MAX_BOT_TOKEN=
MAX_NOTIFY_USER_ID=

# Web Push (PWA): уведомления о новинках — python backend/scripts/generate_vapid_keys.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_SUB=mailto:notify@antrasha.ru
PUBLIC_APP_URL=https://antrasha.ru

# Anthropic + MCP МойСклад (админка: AI ассистент ANTRASHA, только superuser)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=8192
ANTHROPIC_HTTP_TIMEOUT=180
# Если с IP сервера 403 Request not allowed — прокси с выходом вне РФ (как FASHN_HTTPS_PROXY)
# ANTHROPIC_HTTPS_PROXY=http://127.0.0.1:7890
MOYSKLAD_MCP_URL=
MOYSKLAD_MCP_AUTH_TOKEN=
MOYSKLAD_MCP_SERVER_NAME=moysklad
# MOYSKLAD_MCP_ALLOWED_TOOLS=
# MOYSKLAD_MCP_DENIED_TOOLS=
# REST API токен МойСклад (аутлет: штрихкод + загрузка изображений)
MOYSKLAD_TOKEN=

# Fashn / Ximilar (опционально)
FASHN_API_KEY=
FASHN_HTTPS_PROXY=
API_XIMILAR=
