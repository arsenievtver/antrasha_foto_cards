# Домен клиентского приложения (через nginx edge) — сертификат живёт в live/$APP_DOMAIN
APP_DOMAIN=new.antrasha.ru
# Доп. имена того же фронта (без редиректа). Обязательно в кавычках, если несколько.
# Пример: APP_DOMAIN_ALIASES="antrasha.ru www.antrasha.ru"
APP_DOMAIN_ALIASES=

# Домен админки (через nginx edge)
ADMIN_DOMAIN=admin.antrasha.ru

# Домен рабочего PWA для сотрудников (через nginx edge)
WORK_DOMAIN=work.antrasha.ru

# Подарочные сертификаты (десктоп для сотрудников)
GIFT_DOMAIN=giftcard.antrasha.ru

# Лендинг Xfashion (отдельный статический фронт)
XFASHION_DOMAIN=xfashion.pro
# Публичный URL лендинга (canonical, sitemap, сборка образа xfashion)
XFASHION_PUBLIC_URL=https://xfashion.pro
# URL видео для сборки образа xfashion (CDN / Object Storage), опционально
XFASHION_VIDEO_URL=https://storage.yandexcloud.net/files-for-sites/Antrasha_AI_fashion_web_1080p.mp4
# Вертикальная версия 9:16 для hero на телефоне (рекомендуется); без неё на мобилке показывается 16:9 целиком (letterbox)
# XFASHION_VIDEO_MOBILE_URL=https://storage.yandexcloud.net/files-for-sites/Antrasha_AI_fashion_mobile_1080p.mp4

# Почта для Let's Encrypt уведомлений
LETSENCRYPT_EMAIL=ops@antrasha.ru
