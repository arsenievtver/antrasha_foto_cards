# Домен клиентского приложения (через nginx edge) — сертификат живёт в live/$APP_DOMAIN
APP_DOMAIN=new.antrasha.ru
# Доп. имена того же фронта (без редиректа). Обязательно в кавычках, если несколько.
# Пример: APP_DOMAIN_ALIASES="antrasha.ru www.antrasha.ru"
APP_DOMAIN_ALIASES=

# Домен админки (через nginx edge)
ADMIN_DOMAIN=admin.antrasha.ru

# Домен рабочего PWA для сотрудников (через nginx edge)
WORK_DOMAIN=work.antrasha.ru

# Почта для Let's Encrypt уведомлений
LETSENCRYPT_EMAIL=ops@antrasha.ru
