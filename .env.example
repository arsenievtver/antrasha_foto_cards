# Скопируйте в `backend/.env` и/или `.env` в корне репозитория.
# Скрипты `scripts/dev-up.sh` загружают сначала корневой `.env`, затем `backend/.env`.

# --- Приложение (FastAPI) ---
DATABASE_URL=postgresql+psycopg://antrasha:antrasha@localhost:5433/antrasha
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=43200
JWT_REFRESH_EXPIRE_DAYS=180
# Основное приложение (Vite) и админка — оба порта нужны для /api с браузера.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# --- Суперпользователь веб-админки (не строка в БД: только логин/пароль из env) ---
# Пока не заданы USERNAME и один из вариантов пароля — POST /auth/admin/superuser отвечает 503.
ADMIN_SUPERUSER_USERNAME=
# Только для локальной разработки: пароль в открытом виде (в проде лучше bcrypt ниже).
ADMIN_SUPERUSER_PASSWORD=
# Либо bcrypt-хеш пароля (как для PIN пользователей). Если задан — plain-пароль не используется.
ADMIN_SUPERUSER_PASSWORD_BCRYPT=

# --- Postgres приложения (совпадают с DATABASE_URL при Docker из docker-compose) ---
POSTGRES_APP_USER=antrasha
POSTGRES_APP_PASSWORD=antrasha
POSTGRES_APP_DB=antrasha
POSTGRES_HOST=localhost
# Порт на хосте: у Docker из backend/docker-compose это 5433 (внутри контейнера 5432)
POSTGRES_PORT=5433

# --- Суперпользователь Postgres (только если нужно создать роль/БД на своём сервере). ---
# Оставьте пустым при работе только через Docker — контейнер сам создаёт пользователя и БД.
# Если задано, перед миграциями выполнится scripts/db-init.sh → scripts/create_db.py
POSTGRES_SUPERUSER=
POSTGRES_SUPERUSER_PASSWORD=

# --- Режим без Docker для БД (локальный Postgres на машине) ---
SKIP_DOCKER_DB=0

# --- Порты и процессы dev-up ---
BACKEND_PORT=8000
FRONTEND_PORT=5173
ADMIN_PORT=5174
# Не поднимать второй Vite (админку): SKIP_ADMIN=1
# Сборка админки без dev-сервера: npm run build в admin/ с переменной ниже, иначе запросы /api не попадут на FastAPI.
# VITE_BACKEND_ORIGIN=http://127.0.0.1:8000
UVICORN_RELOAD=0

# --- Логи API (файл: backend/logs/app.log, дублирование в stdout → scripts/logs-backend.txt при dev-up) ---
LOG_LEVEL=INFO
# LOG_APP_FILE=/absolute/custom/app.log

# --- Yandex Object Storage (импорт фото: backend/scripts/sync_photos_from_yc.py) ---
# S3 API требует статические ключи (консоль YC → сервисный аккаунт), не IAM-токен.
YC_S3_ENDPOINT=https://storage.yandexcloud.net
YC_S3_REGION=ru-central1
YC_S3_ACCESS_KEY_ID=
YC_S3_SECRET_ACCESS_KEY=
YC_BUCKET_MEN=antrasha-men-foto
YC_BUCKET_WOMEN=antrasha-women-foto
# Необязательный префикс ключей внутри бакета (например folder/):
YC_S3_PREFIX_MEN=
YC_S3_PREFIX_WOMEN=

# Синхронизация бакет → Postgres без ручного скрипта:
# 1) POST .../internal/sync-object-storage  Header: Authorization: Bearer <secret>
#    Прямо: :8000; при dev Vite: http://127.0.0.1:5173/internal/sync-object-storage
#    Endpoint включён только если задан INTERNAL_SYNC_SECRET.
# 2) Или интервал в минутах — фоновый цикл в процессе uvicorn (0 = выключено)
INTERNAL_SYNC_SECRET=
YC_AUTO_SYNC_INTERVAL_MINUTES=0

# --- MAX Bot: уведомление о новой заявке на примерку (личное сообщение вам от бота) ---
# Токен: business.max.ru → Чат-боты → Интеграция → Получить токен
# user_id: ваш числовой ID в MAX (получатель сообщения)
MAX_BOT_TOKEN=
MAX_NOTIFY_USER_ID=

# --- Web Push (PWA): уведомления о новинках (не чаще 1 раз в сутки на подписку) ---
# Сгенерировать: cd backend && python scripts/generate_vapid_keys.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_SUB=mailto:notify@antrasha.ru
# Публичный URL приложения (для ссылки из уведомления)
PUBLIC_APP_URL=https://new.antrasha.ru

# --- Anthropic + MCP МойСклад (админка: AI → AI ассистент ANTRASHA, только superuser) ---
# API key: console.anthropic.com
ANTHROPIC_API_KEY=
# Модель с поддержкой tool use / MCP connector
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=8192
ANTHROPIC_HTTP_TIMEOUT=180
# Личный URL remote MCP из решения «MCP-сервер МойСклад» (SSE / Streamable HTTP)
MOYSKLAD_MCP_URL=
# Bearer/OAuth токен MCP, если решение его требует
MOYSKLAD_MCP_AUTH_TOKEN=
MOYSKLAD_MCP_SERVER_NAME=moysklad
# Опционально: allowlist tools через запятую (рекомендуется после первого теста — только чтение)
# MOYSKLAD_MCP_ALLOWED_TOOLS=report_stock_all,assortment_list
# Или denylist write-tools, если известны имена:
# MOYSKLAD_MCP_DENIED_TOOLS=create_customerorder,update_product

# --- Остановка (dev-down): ---
# DOCKER_DOWN=1 — docker compose stop для контейнера db
# DOCKER_REMOVE=1 — docker compose down
# DOCKER_REMOVE_WITH_VOLUME=1 — docker compose down -v (удалит данные БД в volume)
